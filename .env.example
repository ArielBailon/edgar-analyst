# SEC EDGAR requires a descriptive User-Agent identifying the requester
# (name and email) on every request, per its fair-access policy.
SEC_EDGAR_USER_AGENT=Your Name your@email.com

# Anthropic API key for answer generation (build plan item 6 onward).
# Not needed for ingest, chunking, indexing, retrieval, or the test suite.
ANTHROPIC_API_KEY=sk-ant-your-key-here
